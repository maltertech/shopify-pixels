253994536fef1d438ee1edc12550fc63f6db719ffb94106e055afc9fc9733abd:{"__metadata":{"version":0.1},"root":{"steps":[{"step_id":"01KTSEN6Z61CKE3VGZ73E8N1ZC","step_position":[0,0],"config_field_values":[],"task_id":"shopify::admin::order_created","task_version":"0.1","task_type":"TRIGGER","description":null,"note":null,"name":null},{"step_id":"01KTSEP79Q15F9AZA7K3DXWQZW","step_position":[0,200],"config_field_values":[{"config_field_id":"condition","value":"{\"uuid\":\"01KTSEPHBJZMYGCF91731C0VM3\",\"lhs\":{\"uuid\":\"01KTSEP8ZXZ6CA63G5Q9XDC2HN\",\"parent_uuid\":\"01KTSEPHBJZMYGCF91731C0VM3\",\"lhs\":{\"uuid\":\"01KTSEPHBJSHAS1YFAGRJQATRT\",\"parent_uuid\":\"01KTSEP8ZXZ6CA63G5Q9XDC2HN\",\"value\":\"order.app.name\",\"comparison_value_type\":\"EnvironmentValue\",\"full_environment_path\":\"order.app.name\"},\"rhs\":{\"uuid\":\"01KTSEPNT2K18YPR8STA7VYFPQ\",\"parent_uuid\":\"01KTSEP8ZXZ6CA63G5Q9XDC2HN\",\"value\":\"Online Store\",\"comparison_value_type\":\"LiteralValue\"},\"value_type\":\"EnvironmentScalarDefinition:String\",\"operator\":\"==\",\"operation_type\":\"Comparison\"},\"operator\":\"AND\",\"operation_type\":\"LogicalExpression\"}"}],"task_id":"shopify::flow::condition","task_version":"0.1","task_type":"CONDITION","description":null,"note":null,"name":null},{"step_id":"01KTSEPZ5TCZQF2ZHD658DJ4S5","step_position":[-100,380],"config_field_values":[{"config_field_id":"method","value":"POST"},{"config_field_id":"url","value":"https://bzr.openai.com/v1/events?pid=xxxxxxxxxxxxxxxxxxxx"},{"config_field_id":"headers","value":"[[\"Authorization\",\"Bearer sk-svcacct-xxxxxxxxxxxxxxxxxxxxx\"],[\"Content-Type\",\"application/json\"]]"},{"config_field_id":"body","value":"{%- comment -%} Normalize email before hashing: trim + lowercase {%- endcomment -%}\n{%- assign email_normalized = order.email | strip | downcase -%}\n\n{%- comment -%}\n  Capture oppref from the landing page URL.\n  Strip any #fragment, isolate the query string, then match the\n  \"oppref\" key exactly so params like \"xoppref\" cannot false-match.\n{%- endcomment -%}\n{%- assign oppref_value = \"\" -%}\n{%- if order.landingPageUrl contains \"oppref=\" -%}\n  {%- assign query_string = order.landingPageUrl | split: \"#\" | first | split: \"?\" | last -%}\n  {%- assign query_params = query_string | split: \"&\" -%}\n  {%- for param in query_params -%}\n    {%- assign param_key = param | split: \"=\" | first -%}\n    {%- if param_key == \"oppref\" -%}\n      {%- assign oppref_value = param | remove_first: \"oppref=\" | url_decode -%}\n    {%- endif -%}\n  {%- endfor -%}\n{%- endif -%}\n{\n  \"validate_only\": false,\n  \"events\": [\n    {\n      \"id\": \"{{ order.legacyResourceId }}\",\n      \"type\": \"order_created\",\n      \"timestamp_ms\": {{ \"now\" | date: \"%s\" }}000,\n      \"source_url\": {{ order.landingPageUrl | json }},\n      \"action_source\": \"web\",\n      {%- if oppref_value != blank %}\n      \"oppref\": {{ oppref_value | json }},\n      {%- endif %}\n      {%- if email_normalized != blank %}\n      \"user\": {\n        \"email_sha256\": \"{{ email_normalized | sha256 }}\"\n        {%- if order.billingAddress.countryCodeV2 != blank %},\n        \"country\": {{ order.billingAddress.countryCodeV2 | json }}\n        {%- endif %}\n        {%- if order.billingAddress.zip != blank %},\n        \"zip_code\": {{ order.billingAddress.zip | json }}\n        {%- endif %}\n      },\n      {%- endif %}\n      \"data\": {\n        \"type\": \"contents\",\n        \"amount\": {{ order.totalPriceSet.shopMoney.amount | times: 100 | round }},\n        \"currency\": {{ order.currencyCode | json }},\n        \"contents\": [\n          {%- for line in order.lineItems %}\n          {\n            \"id\": {{ line.sku | default: line.variant.id | json }},\n            \"name\": {{ line.title | json }},\n            \"content_type\": \"product\",\n            \"quantity\": {{ line.quantity }},\n            \"amount\": {{ line.discountedUnitPriceSet.shopMoney.amount | times: 100 | round }},\n            \"currency\": {{ line.discountedUnitPriceSet.shopMoney.currencyCode | json }}\n          }{% unless forloop.last %},{% endunless %}\n          {%- endfor %}\n        ]\n      }\n    }\n  ]\n}"},{"config_field_id":"on_client_error","value":"retry"},{"config_field_id":"on_server_error","value":"retry"}],"task_id":"shopify::flow::send_http","task_version":"2.0","task_type":"ACTION","description":null,"note":null,"name":"Send HTTP request"}],"links":[{"from_step_id":"01KTSEN6Z61CKE3VGZ73E8N1ZC","from_port_id":"output","to_step_id":"01KTSEP79Q15F9AZA7K3DXWQZW","to_port_id":"input"},{"from_step_id":"01KTSEP79Q15F9AZA7K3DXWQZW","from_port_id":"true","to_step_id":"01KTSEPZ5TCZQF2ZHD658DJ4S5","to_port_id":"input"}],"patched_fields":[],"variables":[],"note":null,"vertical_layout_enabled":true,"workflow_name":"OpenAI CAPI | MalterTech"}}